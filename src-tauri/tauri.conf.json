{
  "productName": "device-search",
  "version": "0.1.0",
  "identifier": "dev.devicesearch.app",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "device-search",
        "width": 720,
        "height": 460,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src http://127.0.0.1:8734" }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
